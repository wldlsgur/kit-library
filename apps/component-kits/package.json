{
  "name": "components-kits",
  "description": "A lightweight, reusable React component library for modern apps.",
  "keywords": [
    "react",
    "components",
    "ui",
    "react-components",
    "typescript",
    "frontend"
  ],
  "files": [
    "dist"
  ],
  "author": {
    "name": "dhgg321",
    "url": "https://github.com/wldlsgur"
  },
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "private": false,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preversion": "pnpm build",
    "version": "git add .",
    "postversion": "pnpm publish --no-git-checks",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "test:unit": "vitest",
    "test:unit:cov": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.4",
    "jsdom": "^27.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "5.7.2",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.4"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
